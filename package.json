{
  "name": "boilerplate",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "deadcode": "knip",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "knip": "^6.34.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
